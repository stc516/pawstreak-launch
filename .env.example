# Mapbox — Plan map (Phase 2)
VITE_MAPBOX_TOKEN=
# Optional custom style; defaults to mapbox://styles/mapbox/outdoors-v12
VITE_MAPBOX_STYLE_URL=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public half of the Web Push VAPID key pair. The private key belongs only in
# Supabase Edge Function secrets as WEB_PUSH_VAPID_PRIVATE_KEY.
VITE_WEB_PUSH_PUBLIC_KEY=

# Canonical production origin for OAuth/email redirects (set in Vercel Production only).
# Dev: leave unset — uses window.location.origin (http://localhost:5173).
# Prod: https://pawstreakapp.com
VITE_SITE_URL=

# Supabase dashboard: enable Email + Google OAuth providers
# Site URL: https://pawstreakapp.com
# Redirect URLs (allow list):
#   http://localhost:5173/app
#   https://pawstreakapp.com/app
#   https://pawstreak-launch.vercel.app/app
# Google Cloud → Authorized redirect URI:
#   https://YOUR_PROJECT.supabase.co/auth/v1/callback
