{
  "appId": "com.pawstreak.app",
  "appName": "PawStreak",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#123B2C"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  },
  "ios": {
    "contentInset": "automatic",
    "scheme": "PawStreak"
  },
  "android": {
    "allowMixedContent": false
  }
}
